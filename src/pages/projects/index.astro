---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import ColorScript from "../../components/ColorScript.astro";

import { name, title } from "../../settings/settings.json"

let projects = await getCollection("projects");

projects = projects.sort(
	(a, b) => new Date(b.data.added).valueOf() - new Date(a.data.added).valueOf(),
);
---

<!doctype html>
<html lang="en-us">
	<BaseHead title={`Projects — ${title}`} description={`Things ${name} has built.`} />
	<body>
		<Header />
		<main>
			<content>
				<h3>Things I've built</h3>
				<ul class="posts-list">
					{projects.map(({ id, data }) => <ProjectCard id={id} {...data} />)}
				</ul>
			</content>
		</main>
		<Footer />
		<ColorScript />
	</body>
</html>
