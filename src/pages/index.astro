---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HomePosts from "../components/HomePosts.astro";
import ColorScript from "../components/ColorScript.astro";
import { name, title, subtitle, social } from "../settings/settings.json";

const posts = await getCollection("posts");
---

<!doctype html>
<html lang="en-us">
	<BaseHead title={title} description={subtitle} />
	<body>
		<Header />
		<main>
			<section class="bio">
				<!-- TODO: replace {{PHOTO_PATH}} with actual photo, e.g. /assets/harshit.jpg -->
				<!-- <img src="{{PHOTO_PATH}}" alt={name} class="avatar" /> -->

				<!-- TODO: replace bio paragraph below with final copy -->
				<p>
					Hello! I'm {name.split(' ')[0]}, and I like to code, write, and talk about tech.
					<br /><br />
					Currently, I work as a Software Engineer at <a href="https://imagekit.io">ImageKit</a>, where I build scalable and performant media processing and delivery systems. Outside of work, I'm an active open source-er, a public speaker, a homelab-tinkerer, a solopreneur, and a bit of a minimalist. I enjoy building micro-SaaS products, playing musical instruments (and occasionally, singing), hanging out with my family and friends, and biking around the city in my free time.
				</p>

				<p>
					You should totally follow me on my socials!
				</p>
			</section>

			<hr />

			<h3>Latest posts</h3>

			<HomePosts allPosts={posts} />

			<p class="center">
				<a href="/blog">all posts →</a>
				&nbsp;&nbsp;
				<a href="/rss.xml">rss</a>
			</p>
		</main>
		<Footer />
		<ColorScript />
	</body>
</html>

<style>
	.bio {
		margin: 2rem 0;
	}

	.bio p {
		font-size: 1.05rem;
		line-height: 1.7;
		margin-bottom: 1.2rem;
	}

	.bio-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5rem;
		position: static;
		text-align: left;
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.bio-links a {
		text-decoration: underline;
		text-decoration-thickness: 0.3ex;
		text-underline-offset: 0.3ex;
	}
</style>
