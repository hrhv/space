---
const { href, exact = false, class: className, ...props } = Astro.props;

// Compare without trailing slashes so "/projects/tiku" and "/projects/tiku/"
// match. `exact` keeps a section's home link from staying active on all of
// the section's sub-pages.
const trim = (path) => path.replace(/\/+$/, "") || "/";
const current = trim(Astro.url.pathname);
const target = trim(href);

let isActive;

if (target === "/" || exact) {
	isActive = current === target;
} else {
	isActive = current === target || current.startsWith(`${target}/`);
}

---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
		text-decoration-thickness: 0.3ex;
		text-underline-offset: 0.3ex;
		font-weight: bold;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
		text-decoration-thickness: 0.3ex;
		text-underline-offset: 0.3ex;
	}
</style>
