<script is:inline>
	/* ── Random link decoration colors ─────────────────────────────────────── */

	const ACCENT_COLORS = ["#24d05a", "#eb4888", "#10a2f5", "#e9bc3f"];

	function randomColor() {
		return ACCENT_COLORS[Math.floor(Math.random() * ACCENT_COLORS.length)];
	}

	function paintLinkColors() {
		document.querySelectorAll("a").forEach((el) => {
			el.style.textDecorationColor = randomColor();
		});
	}

	function bindHoverRecolor() {
		document.querySelectorAll("a, button").forEach((el) => {
			el.addEventListener("mouseover", paintLinkColors);
		});
	}

	/* ── Dark mode ──────────────────────────────────────────────────────────── */

	function isDark() {
		return document.documentElement.classList.contains("dark");
	}

	function syncToggleLabel() {
		const btn = document.getElementById("theme-toggle");
		if (!btn) return;
		btn.textContent = isDark() ? "light mode" : "dark mode";
	}

	function bindThemeToggle() {
		const btn = document.getElementById("theme-toggle");
		if (!btn) return;
		btn.addEventListener("click", () => {
			document.documentElement.classList.toggle("dark");
			const next = isDark() ? "dark" : "light";
			localStorage.setItem("theme", next);
			syncToggleLabel();
			paintLinkColors();
			if (typeof umami !== "undefined") {
				umami.track("theme-toggle", { theme: next });
			}
		});
	}

	(function () {
		syncToggleLabel();
		paintLinkColors();
		bindHoverRecolor();
		bindThemeToggle();
	})();
</script>
