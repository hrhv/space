---
import HeaderLink from "./HeaderLink.astro";
import { name, subtitle, photo } from "../settings/settings.json";

// With no props this is the site header. Project pages pass their own
// identity and navbar (see layouts/ProjectLayout.astro).
const {
	heading = name,
	subheading = subtitle,
	href = "/",
	image = photo,
	imageAlt = `${name}'s photo`,
	// "circle" crops a photo; "square" shows a logo as-is.
	imageShape = "circle",
	links = [
		{ href: "/", label: "home", event: "nav-home" },
		{ href: "/blog", label: "blog", event: "nav-blog" },
		{ href: "/socials", label: "socials", event: "nav-socials" },
	],
} = Astro.props;

const external = { target: "_blank", rel: "noopener noreferrer" };
const isExternal = (url) => /^https?:\/\//.test(url);
---

<header>
	<button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
		<span></span><span></span><span></span>
	</button>
	<div class="header-section">
		<div class="header-frame">
			<slot name="eyebrow" />
			<h1><a href={href}>{heading}</a></h1>
			<h2>{subheading}</h2>
		</div>
		<div class:list={["img-frame", imageShape]}>
			<img id="propic" src={image} alt={imageAlt} />
		</div>
	</div>
</header>

<nav>
	<div class="nav-links">
		{
			links.map(({ href, label, event, exact }) => (
				<HeaderLink
					href={href}
					exact={exact}
					data-umami-event={event}
					{...(isExternal(href) ? external : {})}
				>
					{label}
				</HeaderLink>
			))
		}
	</div>
</nav>

<script is:inline>
	const toggle = document.querySelector('.nav-toggle');
	const links  = document.querySelector('.nav-links');
	if (toggle && links) {
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!open));
			links.classList.toggle('open', !open);
		});
		links.querySelectorAll('a').forEach(a => {
			a.addEventListener('click', () => {
				toggle.setAttribute('aria-expanded', 'false');
				links.classList.remove('open');
			});
		});
	}
</script>

<style>
	h1 a {
		text-decoration: none;
		color: inherit;
	}
	h2 {
		margin: 0.5em 0;
		white-space: pre-wrap;
	}
	.img-frame {
		border-radius: 50%;
		width: 200px;
		height: 200px;
		min-width: 200px;
		margin: 10px 0;
		position: relative;
		overflow: hidden;
	}
	.img-frame img {
		height: 100%;
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
	}
	.img-frame.square {
		border-radius: 0;
		overflow: visible;
	}

	/* ── Hamburger — hidden on desktop ── */
	.nav-toggle {
		display:        none;
		background:     none;
		border:         none;
		cursor:         pointer;
		padding:        8px 0;
		flex-direction: column;
		gap:            5px;
	}
	.nav-toggle span {
		display:          block;
		width:            22px;
		height:           2px;
		background-color: var(--fg);
		transition:       transform 0.2s ease, opacity 0.2s ease;
	}
	.nav-toggle[aria-expanded="true"] span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.nav-toggle[aria-expanded="true"] span:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle[aria-expanded="true"] span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* ── Nav links — desktop ── */
	.nav-links {
		display:         flex;
		flex-wrap:       wrap;
		justify-content: center;
		margin-top: 20px;
	}
	.nav-links a {
		margin:  10px 0;
		padding: 0 12px 0 0;
	}
	.nav-links a:last-child {
		padding: 0;
	}

	/* ── Mobile ── */
	@media (max-width: 520px) {
		.nav-toggle {
			display: flex;
		}
		.img-frame {
			width:     120px;
			height:    120px;
			min-width: 120px;
		}
		.nav-links {
			display:        none;
			flex-direction: column;
			align-items:    flex-start;
			padding:        8px 0 12px;
		}
		.nav-links.open {
			display: flex;
		}
		.nav-links a {
			margin:  0;
			padding: 6px 0;
			width:   100%;
		}
	}
</style>
