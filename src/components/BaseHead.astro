---
import "../style/fonts.css";
import "../style/global.css";

import { name, title as SITE_TITLE } from "../settings/settings.json"

const { title, description, image = "/home-blog-card.png" } = Astro.props;
---

<head>
	<!-- Dark mode: apply before paint to avoid flash -->
	<script is:inline>
		if (localStorage.getItem('theme') === 'dark') {
			document.documentElement.classList.add('dark');
		}
	</script>

	<!-- Global Metadata -->
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width,initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
	<meta name="generator" content={Astro.generator} />

	<!-- Google Site Verification — TODO: replace with actual token -->
	<!-- <meta name="google-site-verification" content="{{GOOGLE_SITE_VERIFICATION}}" /> -->

	<!-- Primary Meta Tags -->
	<title>{title}</title>
	<meta name="title" content={title} />
	<meta name="description" content={description} />

	<!-- Canonical URL -->
	<link rel="canonical" href={Astro.url} />

	<!-- Open Graph / Facebook -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={Astro.url} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={new URL(image, Astro.url)} />
	<meta property="og:site_name" content={SITE_TITLE} />

	<!-- Twitter -->
	<meta property="twitter:card" content="summary_large_image" />
	<meta property="twitter:url" content={Astro.url} />
	<meta property="twitter:title" content={title} />
	<meta property="twitter:description" content={description} />
	<meta name="twitter:creator" content="@harshitbudhraja" />
	<meta name="twitter:image" content={new URL(image, Astro.url)} />

	<!-- RSS Link -->
	<link
		rel="alternate"
		href="/rss.xml"
		type="application/rss+xml"
		title={SITE_TITLE}
	/>

	<!-- Sitemap -->
	<link rel="sitemap" href="/sitemap-index.xml" />

	<!-- Knock Knock -->
	<script defer src="https://knockknock.harshitbudhraja.com/script.js" data-website-id="a8291124-ec5c-4df8-b910-0074dd50e126" is:inline></script>
</head>
